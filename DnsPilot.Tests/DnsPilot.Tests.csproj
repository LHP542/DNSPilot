<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- xunit.v3 generiert einen eigenen Entry-Point: das Testprojekt ist eine Exe.
         Ohne das bricht der Build mit "xUnit.net v3 test projects must be executable". -->
    <OutputType>Exe</OutputType>
    <RootNamespace>DnsPilot.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <!-- xunit.v3 bringt den Microsoft.Testing.Platform-Runner selbst mit.
         Microsoft.NET.Test.Sdk und xunit.runner.visualstudio gehören zum alten
         VSTest-Pfad, den das .NET-10-SDK nicht mehr unterstützt. -->
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sicherheitsnetz gegen allokierende Endlosschleifen: der Testlauf stirbt mit
         OutOfMemoryException statt den Rechner leerzufressen. -->
    <RuntimeHostConfigurationOption Include="System.GC.HeapHardLimit" Value="0x40000000" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../DnsPilot/DnsPilot.csproj" />
  </ItemGroup>
</Project>
