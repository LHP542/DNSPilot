<?xml version="1.0" encoding="utf-8"?>
<!-- Kroste-Standard: So viel wie möglich loggen. Datei = Trace aufwärts (alles),
     Konsole = Info aufwärts. Secrets laufen über den masked-Layout-Renderer
     (Logging/MaskingLayoutRenderer.cs, per ModuleInitializer registriert).

     ACHTUNG bei internalLogFile: das ist ein simpler Dateiname, KEIN Layout.
     Erlaubt sind nur ${basedir}, ${currentdir}, ${tempdir} und %ENVVAR%. -->
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      internalLogLevel="Warn"
      internalLogFile="${tempdir}/DnsPilot/nlog-internal.log">

  <targets>
    <target xsi:type="File" name="file"
            fileName="${specialfolder:folder=LocalApplicationData}/DnsPilot/logs/DnsPilot.log"
            archiveFileName="${specialfolder:folder=LocalApplicationData}/DnsPilot/logs/archive/DnsPilot.{#}.log"
            archiveEvery="Day"
            maxArchiveFiles="14"
            layout="${longdate}|${level:uppercase=true}|${logger}|${masked:inner=${message}}${onexception:inner=|${exception:format=tostring}}" />

    <target xsi:type="ColoredConsole" name="console"
            layout="${time}|${level:uppercase=true}|${logger:shortName=true}|${masked:inner=${message}}${onexception:inner=|${exception:format=message}}" />
  </targets>

  <rules>
    <!-- Alles in die Datei — Trace ist Absicht, nicht Versehen -->
    <logger name="*" minlevel="Trace" writeTo="file" />
    <logger name="*" minlevel="Info" writeTo="console" />
  </rules>
</nlog>
