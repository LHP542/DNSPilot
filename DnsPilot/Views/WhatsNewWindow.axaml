<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DnsPilot.Views"
        xmlns:controls="using:DnsPilot.Controls"
        x:Class="DnsPilot.Views.WhatsNewWindow"
        Title="Was ist neu"
        Width="640" Height="620"
        MinWidth="480" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="Was ist neu" />

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource KrosteTitleBarBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <Button x:Name="CloseButton" Classes="accent" Content="Schließen" HorizontalAlignment="Right" />
        </Border>

        <Grid Margin="16,14" RowDefinitions="Auto,*">
            <StackPanel Spacing="2">
                <TextBlock x:Name="Headline" Classes="h1" Text="Was ist neu" />
                <TextBlock x:Name="SubText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>

            <Border Grid.Row="1" Classes="card" Margin="0,12,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="NotesPanel" Margin="0,0,14,0" />
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</views:ChromeWindow>
