<views:ChromeWindow xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="using:DnsPilot.Views"
        xmlns:controls="using:DnsPilot.Controls"
        xmlns:vm="using:DnsPilot.ViewModels"
        x:Class="DnsPilot.Views.NewHostWindow"
        x:DataType="vm:NewHostWindowViewModel"
        Title="Neuer Host"
        Width="560" SizeToContent="Height"
        MinWidth="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource KrosteBackgroundBrush}">

    <DockPanel>
        <controls:TitleBar DockPanel.Dock="Top" Title="Neuer Host" />

        <Border DockPanel.Dock="Bottom"
                Background="{DynamicResource KrosteTitleBarBrush}"
                BorderBrush="{DynamicResource KrosteBorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="16,10">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                <Button Content="Abbrechen" Command="{Binding CancelCommand}" />
                <Button Content="Anlegen" Classes="accent" Command="{Binding CreateCommand}" />
            </StackPanel>
        </Border>

        <StackPanel Margin="16,14" Spacing="12">
            <StackPanel Spacing="2">
                <TextBlock Text="Neuer Host" Classes="h1" />
                <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                           Text="Legt einen statischen A-Eintrag an und auf Wunsch den passenden PTR." />
            </StackPanel>

            <Border Classes="card">
                <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Zone" Classes="secondary" FontSize="12" />
                        <ComboBox ItemsSource="{Binding Zones}" SelectedItem="{Binding SelectedZone, Mode=TwoWay}"
                                  HorizontalAlignment="Stretch" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="Name (ohne Zone)" Classes="secondary" FontSize="12" />
                        <TextBox x:Name="NameBox" Text="{Binding HostLabel, Mode=TwoWay}"
                                 PlaceholderText="z. B. drucker-3og" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="IPv4-Adresse" Classes="secondary" FontSize="12" />
                        <TextBox Text="{Binding Address, Mode=TwoWay}" Classes="mono"
                                 PlaceholderText="z. B. 172.16.1.50" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="TTL (Sekunden)" Classes="secondary" FontSize="12" />
                        <TextBox Text="{Binding TtlText, Mode=TwoWay}" Width="140" HorizontalAlignment="Left" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <CheckBox Content="PTR-Eintrag mit anlegen"
                                  IsChecked="{Binding CreatePtr, Mode=TwoWay}"
                                  IsEnabled="{Binding CanCreatePtr}" />
                        <TextBlock Text="{Binding ReverseZoneText}" Classes="muted" FontSize="11"
                                   TextWrapping="Wrap" Margin="28,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Preview}" Classes="mono" HorizontalAlignment="Center"
                       Foreground="{DynamicResource KrosteGoldBrush}"
                       IsVisible="{Binding Preview, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <Border Classes="card" IsVisible="{Binding HasErrors}"
                    Background="{DynamicResource KrosteDangerSoftBrush}"
                    BorderBrush="{DynamicResource KrosteDangerBrush}">
                <TextBlock Text="{Binding ErrorsText}" TextWrapping="Wrap" />
            </Border>

            <Border Classes="card" IsVisible="{Binding HasWarnings}"
                    Background="{DynamicResource KrosteWarningSoftBrush}"
                    BorderBrush="{DynamicResource KrosteWarningBrush}">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding WarningsText}" TextWrapping="Wrap" />
                    <CheckBox Content="Trotzdem anlegen" IsChecked="{Binding AcceptWarnings, Mode=TwoWay}" />
                </StackPanel>
            </Border>

            <Border Classes="card"
                    IsVisible="{Binding ResultMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource KrosteDangerSoftBrush}"
                    BorderBrush="{DynamicResource KrosteDangerBrush}">
                <SelectableTextBlock Text="{Binding ResultMessage}" TextWrapping="Wrap" />
            </Border>

            <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
        </StackPanel>
    </DockPanel>
</views:ChromeWindow>
